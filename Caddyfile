# Reverse proxy с автоматическим HTTPS (Let's Encrypt). Запуск: docker compose --profile proxy up -d
# Домен берётся из SITE_DOMAIN (.env). Для SITE_DOMAIN=localhost Caddy выпустит локальный сертификат.
# DNS домена должен указывать на сервер, порты 80 и 443 (tcp+udp) должны быть открыты.
# www -> основной домен (постоянный редирект, чтобы поисковики не считали их разными сайтами).
www.{$SITE_DOMAIN:localhost} {
	redir https://{$SITE_DOMAIN:localhost}{uri} permanent
}

{$SITE_DOMAIN:localhost} {
	encode zstd gzip

	# Хэшированные статические файлы Next.js — кэшируем навсегда.
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	# Загруженные фото (имена содержат хэш/uuid) — кэш на месяц.
	@uploads path /uploads/*
	header @uploads Cache-Control "public, max-age=2592000"

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	# Загрузка фото до 8 МБ по умолчанию (MAX_UPLOAD_BYTES) + запас на multipart.
	request_body {
		max_size 20MB
	}

	# Caddy сам передаёт X-Forwarded-For/Proto/Host.
	reverse_proxy frontend:3000
}
