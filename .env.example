# Шаблон конфигурации. Скопируйте в .env (cp .env.example .env) и заполните.
# .env в git не попадает. Реальные секреты хранить только там / в секретах CI.

# ==========================================================================
# Общие / Docker Compose / reverse proxy
# ==========================================================================
# Домен для Caddy (профиль proxy) — HTTPS выпускается автоматически.
# Для локальной проверки можно оставить localhost (локальный сертификат).
SITE_DOMAIN=localhost
# Порт и интерфейс публикации frontend в docker compose.
# По умолчанию порт открыт только на самой машине (127.0.0.1): снаружи сайт
# должен ходить через Caddy (профиль proxy). Если доступа в обход Caddy не нужно
# закрывать (например, при проверке в локальной сети), поставьте FRONTEND_HOST=0.0.0.0,
# но имейте в виду: в compose включён TRUST_PROXY, и открытый наружу порт позволяет
# обойти защиту входа подменой X-Forwarded-For.
FRONTEND_PORT=3000
FRONTEND_HOST=127.0.0.1

# ==========================================================================
# frontend (Next.js). NEXT_PUBLIC_* вшиваются при СБОРКЕ: после изменения
# пересоберите образ (docker compose build frontend).
# ==========================================================================
# Публичный адрес сайта (canonical, Open Graph, sitemap, JSON-LD).
# В проде — https://ваш-домен, без слэша на конце. Он же используется как
# разрешённый Origin для входа в админку (см. ALLOWED_ORIGINS).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Запасные ссылки на мессенджеры: используются, только если ссылка в настройках (админка) пуста.
NEXT_PUBLIC_MAX_URL=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_VK_URL=
# Адрес backend, на который frontend проксирует /api и /uploads.
# Локально без Docker: http://localhost:8000. В docker compose задаётся
# автоматически (http://backend:8000), значение отсюда игнорируется.
BACKEND_URL=http://localhost:8000

# ==========================================================================
# backend (FastAPI)
# ==========================================================================
# production: SECRET_KEY и пароль администратора обязательны, /docs отключены.
ENVIRONMENT=development
# Подпись сессий. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Смена ключа разлогинит всех.
SECRET_KEY=
# Логин единственного администратора.
ADMIN_USERNAME=admin
# Пароль для первого запуска / разработки (открытым текстом, только в .env).
ADMIN_PASSWORD=
# В проде лучше bcrypt-хеш (если задан, ADMIN_PASSWORD игнорируется). Сгенерировать:
#   python -c "import bcrypt,getpass; print(bcrypt.hashpw(getpass.getpass().encode(), bcrypt.gensalt()).decode())"
# ВАЖНО: символы $ в хеше в .env для docker compose удваивайте ($$) или берите значение в одинарные кавычки.
ADMIN_PASSWORD_HASH=
# БД SQLite. Относительный путь считается от каталога backend/. В Docker задаётся автоматически (/app/data/app.db).
DATABASE_URL=sqlite:///./data/app.db
# Каталог загруженных фото. В Docker — /app/uploads (том).
UPLOADS_DIR=uploads
# true при работе по HTTPS (cookie сессии получает флаг Secure). В проде — true.
COOKIE_SECURE=false
# Доп. разрешённые Origin для изменяющих запросов админки (через запятую),
# например https://example.ru,https://www.example.ru. Если пусто, в docker compose
# берётся NEXT_PUBLIC_SITE_URL. Вход в админку работает, если Origin совпал с этим
# списком либо с заголовками Host / X-Forwarded-Host.
ALLOWED_ORIGINS=
# true только за собственным reverse proxy (учитывать X-Forwarded-For для лимита попыток входа).
# В docker compose выставляется в true автоматически (backend не опубликован наружу).
TRUST_PROXY=false
# Максимальный размер загружаемого фото, байт (по умолчанию 8 МиБ).
MAX_UPLOAD_BYTES=8388608
